\vspace{-0.25em}
\begin{table}[ht]
\centering
\setlength{\tabcolsep}{1.25pt}
\begin{tabular}{L{0.70cm}L{0.78cm}L{2.05cm}R{0.62cm}R{0.62cm}R{0.62cm}L{1.10cm}}
\toprule
Track & Univ. & Selected OOS winner & Alpha 5 & Alpha 10 & Alpha 20 & Ranking read \\
\midrule
Temp. & Total & AG Base; Youden 3yr & +0.43pp & +0.43pp & +0.42pp & unchanged \\
Temp. & Large & AG Base; Youden 3yr & +0.15pp & +0.15pp & +0.15pp & unchanged \\
Temp. & Mid & AG Base; FPR5 5yr & +0.51pp & +0.51pp & +0.51pp & unchanged \\
Temp. & Small & AG +VAE; Youden 3yr & +0.63pp & +0.63pp & +0.62pp & unchanged \\
Perm. & Total & AG +VAE; FPR5 perm. & +0.27pp & +0.27pp & +0.27pp & unchanged \\
Perm. & Large & AG +VAE; FPR5 perm. & +0.23pp & +0.23pp & +0.23pp & unchanged \\
Perm. & Mid & AG Base; FPR5 perm. & +0.74pp & +0.74pp & +0.74pp & unchanged \\
