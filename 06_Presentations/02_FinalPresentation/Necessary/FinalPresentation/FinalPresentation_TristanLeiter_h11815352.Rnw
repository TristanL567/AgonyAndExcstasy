%==== Appendix A4: Low-Vol 1: Methodology =====================================%

\begin{frame}{Appendix A4: Low-volatility and its interaction with CSI}
\scriptsize

\begin{alertblock}{Methodology: low-volatility comparison}
\scriptsize
\begin{itemize}\setlength\itemsep{1pt}
  \item Firms are sorted by trailing five-year realized volatility into quintiles Q1 (low-vol)--Q5 (high-vol).
  \item The sort is rebuilt inside each benchmark universe: Total, Large, Mid, and Small are each comparable to the CSI models.
  \item Portfolios are cap-weighted within quintile; low-vol and CSI rows are evaluated with 20\,bps transaction costs, while the market benchmark remains the 0\,bps reference.
\end{itemize}
\end{alertblock}

\vspace{0.25em}

\begin{center}
{\scriptsize\color{MainColour}\textbf{Realized volatility rises monotonically across quintiles within the test-set.}}\\[-0.2em]
\begin{tikzpicture}[x=1cm,y=1cm]
  \draw[darkgrey,line width=0.6pt] (0,0) -- (5.05,0);

  \fill[lightblue,draw=MainColour,line width=0.7pt] (0.15,0) rectangle (0.85,0.690);
  \fill[darkgrey] (1.10,0) rectangle (1.80,0.924);
  \fill[darkgrey] (2.05,0) rectangle (2.75,1.102);
  \fill[darkgrey] (3.00,0) rectangle (3.70,1.194);
  \fill[warningRed] (3.95,0) rectangle (4.65,1.500);

  \node[font=\scriptsize] at (0.50,0.690) [above=0.0mm] {9.7\%};
  \node[font=\scriptsize] at (1.45,0.924) [above=0.0mm] {13.0\%};
  \node[font=\scriptsize] at (2.40,1.102) [above=0.0mm] {15.5\%};
  \node[font=\scriptsize] at (3.35,1.194) [above=0.0mm] {16.8\%};
  \node[font=\scriptsize] at (4.30,1.500) [above=0.0mm] {21.1\%};

  \node[font=\scriptsize] at (0.50,0) [below] {Q1};
  \node[font=\scriptsize] at (1.45,0) [below] {Q2};
  \node[font=\scriptsize] at (2.40,0) [below] {Q3};
  \node[font=\scriptsize] at (3.35,0) [below] {Q4};
  \node[font=\scriptsize] at (4.30,0) [below] {Q5};

  \node[font=\scriptsize,MainColour] at (0.50,-0.45) {low-volatility};
  \node[font=\scriptsize,warningRed] at (4.30,-0.45) {high-volatility};
\end{tikzpicture}
\end{center}

\begin{block}{Motivation}
\footnotesize
The low-volatility screen removes firms because they are volatile. The CSI screen removes firms because the model ranks them as likely implosion candidates. The comparison asks whether the classification layer improves index outcomes without simply reproducing a generic volatility tilt.
\end{block}

\end{frame}

