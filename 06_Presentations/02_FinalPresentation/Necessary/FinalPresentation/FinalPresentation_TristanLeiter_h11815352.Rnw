%==== 27. Results of the key-cutoffs ==========================================%
\begin{frame}{Results of the key-cutoffs across the two CSI methodologies}
\centering
\vspace*{\fill}

\makebox[\textwidth][c]{%
\begin{tikzpicture}[x=1cm,y=1cm]
\path[use as bounding box] (0,0) rectangle (10.6,6.15);

  % ===== background zones =====
  \fill[grey!35,rounded corners=5pt]      (0,1.0)    rectangle (5.15,6.15);
  \fill[lightblue!55,rounded corners=5pt] (5.45,1.0) rectangle (10.6,6.15);

  % ===== LEFT: Temporary CSI =====
  \node[font=\normalsize\bfseries]                  at (2.575,5.78) {Temporary CSI};
  \node[font=\scriptsize\itshape,text=darkgrey]     at (2.575,5.36) {finite lockout $\cdot$ 3--5 yr};
  % flag lifecycle: triggers, locks out, then RELEASED
  \foreach \i/\c in {0/white,1/white,2/warningRed,3/warningRed!35,4/warningRed!35,5/white}{
    \draw[draw=darkgrey!60,fill=\c] ({0.97+\i*0.55},4.42) rectangle ({0.97+\i*0.55+0.46},4.82);}
  \node[font=\tiny,text=darkgrey] at (2.575,4.14) {flag raised $\rightarrow$ \textbf{released}};
  \node[font=\scriptsize,text width=4.5cm,align=center] at (2.575,3.45)
    {A wrong flag \textbf{self-corrects} once the lockout expires.};
  \node[rounded corners=3pt,fill=MainColour,text=white,font=\scriptsize\bfseries,inner sep=4pt]
    at (2.575,2.55) {More permissive cutoff: Youden};
  \node[font=\scriptsize] at (2.575,1.85) {mean best alpha \textbf{$+0.24$\,pp}};

  % ===== RIGHT: Permanent CSI =====
  \node[font=\normalsize\bfseries]                  at (8.025,5.78) {Permanent CSI};
  \node[font=\scriptsize\itshape,text=darkgrey]     at (8.025,5.36) {absorbing $\cdot$ irreversible};
  % flag lifecycle: triggers, then NEVER released
  \foreach \i/\c in {0/white,1/white,2/warningRed,3/warningRed!35,4/warningRed!35,5/warningRed!35}{
    \draw[draw=darkgrey!60,fill=\c] ({6.42+\i*0.55},4.42) rectangle ({6.42+\i*0.55+0.46},4.82);}
  \draw[-{Stealth[length=2mm]},warningRed!70,line width=0.9pt] (9.78,4.62) -- (10.25,4.62);
  \node[font=\tiny,text=darkgrey] at (8.025,4.14) {flag raised $\rightarrow$ \textbf{stays forever}};
  \node[font=\scriptsize,text width=4.5cm,align=center] at (8.025,3.45)
    {A wrong flag is \textbf{stuck for good}.};
  \node[rounded corners=3pt,fill=MainColour,text=white,font=\scriptsize\bfseries,inner sep=4pt]
    at (8.025,2.55) {Stricter cutoff: FPR3 / FPR5};
  \node[font=\scriptsize] at (8.025,1.85) {FPR \textbf{$+0.24$/$+0.22$\,pp} $\cdot$ Youden \textbf{$-0.31$\,pp}};

  % ===== takeaway strip =====
  \node[rounded corners=4pt,fill=MainColour,text=white,font=\scriptsize\bfseries,
        minimum width=10.6cm,minimum height=0.72cm,text width=10.15cm,align=center] at (5.3,0.45)
    {The cutoff is determined by the CSI-methodology. Youden allows for more CSI-events in the temporary-CSI sample.};

\end{tikzpicture}%
}

{\tiny
\begin{minipage}{0.86\textwidth}
\raggedright
Mean best benchmark-relative alpha across universes at 20\,bps. The threshold choice is motivated by
\citet{HernandezOrallo2012}, who show that threshold choice depends on methodology.
Additionally, \citet{Tong2018} support FPR-style cutoffs to control type-I errors while
minimizing type-II errors.
\end{minipage}
}
\vspace*{\fill}

\end{frame}

%==== 28. Main Summary: Mechanism =============================================%

\begin{frame}{Summary: risk screening, not crash avoidance}
\centering
\vspace{0.05em}

\begin{tikzpicture}[x=1cm,y=1cm,
  num/.style={circle, text=white, inner sep=0pt, minimum size=0.52cm, font=\scriptsize\bfseries},
  steptext/.style={anchor=north west, align=left, text width=10.05cm, inner sep=0pt}]

  % ---- spine flowing into the verdict ----
  \draw[-{Stealth[length=2.6mm]}, MainColour!55, line width=1.2pt] (0.55,6.12) -- (0.55,1.62);

  % ---- step 1 ----
  \node[num, fill=posgreenL] at (0.55,5.84) {1};
  \node[steptext] at (0.98,6.03)
    {{\small\bfseries Models rank implosion risk well}\\[-0.22em]
     {\scriptsize AUC $\approx 0.88$; AP $\approx 4.5\times$ base rate; noisy cutoffs \citep{HillegeistKeatingCramLundstedt2004}.}};

  % ---- step 2 ----
  \node[num, fill=MainColour] at (0.55,4.66) {2};
  \node[steptext] at (0.98,4.85)
    {{\small\bfseries But the exclusion cutoff is unavoidably noisy}\\[-0.22em]
     {\scriptsize False positives overlap true positives: $\approx$4 healthy firms per real CSI \citep{Saito2015}.}};

  % ---- step 3 ----
  \node[num, fill=MainColour] at (0.55,3.48) {3};
  \node[steptext] at (0.98,3.67)
    {{\small\bfseries So the gain comes from reweighting, not avoidance}\\[-0.22em]
     {\scriptsize False-positive drag dominates; retained-firm reweighting carries most alpha \citep{Penman2018,Campbell2008}.}};

  % ---- step 4 ----
  \node[num, fill=MainColour] at (0.55,2.30) {4};
  \node[steptext] at (0.98,2.49)
    {{\small\bfseries And the effect is dilution-bounded}\\[-0.22em]
     {\scriptsize CSI firms are $\approx$1\% of cap; Mid/Small effects are less diluted.}};

  % ---- verdict banner ----
  \node[rounded corners=5pt, fill=MainColour, text=white, align=center,
        text width=10.0cm, inner sep=5pt] at (5.3,1.08)
    {\footnotesize\bfseries A useful risk-reduction and portfolio-selection method,\\
     but the alpha is not driven by direct CSI-event avoidance.};

\end{tikzpicture}

\end{frame}

